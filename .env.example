# Plantilla de variables de entorno (.env.example)
# Este archivo SÍ se sube a Git. 
# Los nuevos desarrolladores deben copiar este archivo, renombrarlo a ".env" 
# y reemplazar los valores con sus credenciales reales.

# Configuración de Base de Datos SQL (PostgreSQL/MySQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://<DB_HOST>:<DB_PORT>/<DB_NAME>
SPRING_DATASOURCE_USERNAME=<TU_USUARIO>
SPRING_DATASOURCE_PASSWORD=<TU_PASSWORD>

# Configuración de MongoDB
SPRING_DATA_MONGODB_URI=mongodb://<MONGO_HOST>:<MONGO_PORT>/<MONGO_DB>

# Configuración de Redis
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# Configuración de Seguridad
JWT_SECRET=reemplazar_con_tu_secreto_super_seguro_en_produccion_2024!
JWT_EXPIRATION_MS=86400000

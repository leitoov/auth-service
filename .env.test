# Variables de entorno exclusivas para el ambiente de TESTING (.env.test)
# Se apuntan a bases de datos distintas (con el sufijo _test) para no borrar los datos reales al correr las pruebas.

# Configuración de Base de Datos SQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/nefetech_central_test
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=root

# Configuración de MongoDB
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/nefetech_logs_test

# Configuración de Redis
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# Configuración de Seguridad
JWT_SECRET=UnSecretoFalsoParaQueLosTestsPuedanCorrerTranquilamenteSinQuejarse!
JWT_EXPIRATION_MS=3600000
